# ========================================================
# الگوی تنظیمات سامانه «کافی نت لیمو» (.env.example)
# ========================================================
# این فایل صرفاً نمونه است. فایل اصلی (.env) حاوی مقادیر واقعی است
# و هرگز نباید وارد مخزن کنترل نسخه یا گزارش‌ها شود.

# توکن محرمانه ربات تلگرام (دریافتی از @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# شناسه عددی یکتای مدیر سیستم در تلگرام (قابل دریافت از ربات‌هایی نظیر @userinfobot)
# در صورتی که این مقدار خالی باشد، سیستم در حالت Default-Deny قرار گرفته و دسترسی ادمین به همه مسدود است.
ADMIN_ID=

# منطقه زمانی استاندارد سامانه (پیش‌فرض مصوب: Asia/Tehran)
TIMEZONE=Asia/Tehran

# محیط اجرای سامانه (development | test | production)
ENVIRONMENT=development

# نشانی اتصال به پایگاه داده (پیش‌فرض: فایل SQLite محلی در پوشه storage)
# برای مهاجرت به پُستگرس در آینده: postgresql://user:password@localhost:5432/limodb
DATABASE_URL=sqlite:///storage/limo.db
